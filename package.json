{
  "name": "caldate",
  "version": "2.0.5",
  "description": "Calendar date for date-holidays",
  "keywords": [
    "calendar",
    "date"
  ],
  "homepage": "https://github.com/commenthol/caldate",
  "bugs": {
    "url": "https://github.com/commenthol/caldate/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commenthol/caldate.git"
  },
  "license": "ISC",
  "author": "commenthol <commenthol@gmail.com>",
  "maintainers": [
    "commenthol <commenthol@gmail.com>"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.cjs",
  "module": "./src/index.js",
  "types": "./types",
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "files": [
    "lib",
    "src",
    "types"
  ],
  "scripts": {
    "all": "run-s clean pretty lint types build test types",
    "build": "rollup -c",
    "ci": "run-s all",
    "clean": "rimraf lib types coverage",
    "clean:all": "run-s clean clean:node_modules",
    "clean:node_modules": "rimraf node_modules",
    "coverage": "c8 -r text -r html npm run test:ci",
    "lint": "eslint src test",
    "pretty": "prettier -w src test",
    "readme": "markedpp --githubid -i README.md -o README.md",
    "test": "mocha",
    "types": "tsc -p ./tsconfig.json"
  },
  "mocha": {
    "checkLeaks": true,
    "colors": true
  },
  "dependencies": {
    "moment-timezone": "^0.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "c8": "^12.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "mocha": "^12.0.3",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "rollup": "^4.67.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=12.0.0"
  }
}
